# Zulip Integration — Hermes Plugin
#
# Copy to ~/.hermes/.env and fill in the required three values.
# Everything below the "Optional" markers is off unless you set it.
# Full reference (with examples): README.md -> Environment Variable Reference

# ---------------------------------------------------------------- Required

ZULIP_API_KEY=your-bot-api-key-here
ZULIP_EMAIL=your-bot@niyaz.zulipchat.com
ZULIP_SITE=https://niyaz.zulipchat.com

# ---------------------------------------------------------------- Profile

# One name for a whole default posture, so a fresh install behaves like a
# complete shared-room teammate instead of 50 flags. Set this and stop; every
# other setting below stays optional and any explicit value wins over the
# preset. Unset means the legacy behaviour, unchanged.
#
# recommended = mention-gated streams, DMs allowed for the bot's Zulip owner
#               only, activity trace on, history on-demand, observation on,
#               per-session queue on, per-topic sessions on, and the reaction
#               triggers +1 / repeat / arrows_counterclockwise / test_tube /
#               question enabled. Sticky engagement and actionable refs stay
#               off.
# ZULIP_PROFILE=recommended

# ---------------------------------------------------------------- Access control

# Who can DM the bot: open | allowlist | pairing | disabled
# ZULIP_DM_POLICY=open

# Comma-separated DM allowlist (used by allowlist / pairing).
# ZULIP_ALLOWED_USERS=you@niyaz.zulipchat.com

# The bot owner's Zulip email. With ZULIP_PROFILE=recommended the owner is
# discovered from Zulip and allowed to DM automatically, so this is only needed
# when that cannot work (an organisation-owned bot, an older SDK) or when it
# picked the wrong person. Without it, an unresolvable owner means NO ONE can DM
# the bot -- the startup log says so.
# ZULIP_OWNER_EMAIL=you@niyaz.zulipchat.com

# Who can trigger the bot in streams: open | allowlist | disabled
# ZULIP_GROUP_POLICY=open
# ZULIP_GROUP_ALLOW_FROM=

# Per-sender rate limit; 0 disables.
# ZULIP_MAX_MESSAGES_PER_MINUTE=60

# Disables ALL authorization. Development only.
# ZULIP_ALLOW_ALL_USERS=false

# ---------------------------------------------------------------- Triggering

# onmessage = answer every stream message
# oncall    = answer only when @mentioned      <- recommended for shared streams
# onchar    = answer when a prefix is typed (see ZULIP_ONCHAR_PREFIXES)
# ZULIP_CHATMODE=oncall

# Require an @mention in streams (except in onmessage mode).
# ZULIP_REQUIRE_MENTION=true

# Prefixes that trigger onchar mode.
# ZULIP_ONCHAR_PREFIXES=!,>

# Streams to monitor; * = all public streams.
# ZULIP_STREAMS=*

# Per-stream chatmode overrides, as JSON.
# ZULIP_STREAM_OVERRIDES={"bot lab": {"chatmode": "onmessage"}}

# Default stream id for cron `deliver: zulip` targets.
# ZULIP_HOME_CHANNEL=573423

# Watch a busy stream WITHOUT replying to everything: dispatch every message and tag it
# addressed=true/false so the agent decides. Do NOT combine with ZULIP_OBSERVE_GROUP.
# ZULIP_SOFT_GATE=1

# Remember non-addressed stream messages as topic context (quoted into the prompt the next
# time the bot is mentioned in that topic). Do NOT combine with ZULIP_SOFT_GATE.
# ZULIP_OBSERVE_GROUP=1

# ---------------------------------------------------------------- Sessions

# Give each stream topic its own conversation session.
# ZULIP_TOPIC_SESSIONS=false

# Rotate a DM session after N turns to limit context growth; 0 disables.
# ZULIP_DM_SESSION_TURN_LIMIT=20

# Hold a message that arrives mid-run behind the running turn, instead of steering it into
# the running work. Useful when several people share a topic. Separate topics still run in
# parallel.
# ZULIP_SESSION_QUEUE=1
# ZULIP_QUEUE_CAP=20

# ---------------------------------------------------------------- Exec approvals

# What an unanswered exec approval means. The gateway owns the timeout and refuses the
# command either way — this says whether the bot also *states* the refusal in the topic
# and records it in the audit log with `timeout` as the decider.
#   allow (default) — today's behaviour: the gateway's refusal stands, the bot adds nothing
#   deny            — fail closed and say so (the recommended profile sets this)
# ZULIP_APPROVAL_ON_TIMEOUT=allow

# ---------------------------------------------------------------- Sticky engagement

# Keep answering follow-ups in a topic after the first @mention, so users don't have to
# re-mention the bot in every message.
# ZULIP_ENGAGEMENT_MODE=sticky_topic   # off (default) | sticky_topic
# ZULIP_ENGAGEMENT_SCOPE=user          # user (only the mentioner) | topic (anyone)
# ZULIP_ENGAGEMENT_TTL_MINUTES=45      # idle window before it lapses
# ZULIP_ENGAGEMENT_EXPIRY_NOTICE=true  # post a notice when it lapses
# ZULIP_ENGAGEMENT_EXPIRY_SCAN_SECONDS=30

# ---------------------------------------------------------------- Status reactions

# 👀 while working, ✅ on success, ⚠️ on failure.
# ZULIP_REACTIONS_ENABLED=true
# ZULIP_REACTION_START=eyes
# ZULIP_REACTION_SUCCESS=check_mark
# ZULIP_REACTION_ERROR=warning
# ZULIP_REACTION_CLEAR_ON_FINISH=true

# ---------------------------------------------------------------- Action triggers

# A reaction on the bot's OWN message dispatches that instruction as a turn in the same
# topic. Emoji names are Zulip API names (+1 = 👍, eyes = 👀), not glyphs.
# ZULIP_REACTION_TRIGGERS={"+1": "Proceed with the proposed step."}

# Also allow triggers on messages the bot did not author.
# ZULIP_REACTION_TRIGGER_ANY_MESSAGE=false

# ---------------------------------------------------------------- Activity trace

# One status message per run, edited in place as the agent works, closed out at the end.
# ZULIP_ACTIVITY_TRACE=1
# ZULIP_TRACE_COALESCE_MS=400
# ZULIP_TRACE_MAX_RATE=2
# ZULIP_TRACE_MAX_CONTENT=3500
# Which tool calls become checkpoints: allowlist, or !name to exclude.
# ZULIP_TRACE_TOOL_MATCHER=terminal,!browser

# ---------------------------------------------------------------- History context

# Quote real earlier messages from the same topic into the prompt.
# ZULIP_HISTORY_MODE=on-demand   # off (default) | on-demand | always
# ZULIP_HISTORY_MAX_MESSAGES=8
# ZULIP_HISTORY_WINDOW_HOURS=72
# ZULIP_HISTORY_MAX_CHARS=4000

# ---------------------------------------------------------------- Output and security

# Max characters per outbound message.
# ZULIP_TEXT_CHUNK_LIMIT=10000
# ZULIP_CHUNK_MODE=length        # length | newline

# Hard cap on a single outbound message before chunking; 0 disables.
# ZULIP_MAX_MESSAGE_LENGTH=20000

# Prefix prepended to every reply, e.g. to mark bot output.
# ZULIP_RESPONSE_PREFIX=

# Refuse to send a message containing a host credential value.
# ZULIP_BLOCK_SECRET_LEAKS=true

# Allow an http:// or private ZULIP_SITE. The API key then travels unencrypted.
# ZULIP_ALLOW_INSECURE_HTTP=false

# Max inbound attachment size in MB.
# ZULIP_MEDIA_MAX_MB=5

# Extra directories the gateway may read inbound media from.
# HERMES_MEDIA_ALLOW_DIRS=

# ---------------------------------------------------------------- Timeouts

# ZULIP_CONNECT_TIMEOUT=30
# ZULIP_READ_TIMEOUT=60
# ZULIP_SEND_TIMEOUT=90
